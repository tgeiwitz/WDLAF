# Anthropic API key for Claude (powers the natural language understanding)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# WooDelivery API key (from Settings > Integration in WooDelivery dashboard)
WOODELIVERY_API_KEY=your-woodelivery-api-key-here

