# WDLAF Dispatch Agent — Environment Variables
# Copy to .env and fill in your values

# --- Todd's phone number for approval SMS ---
TODD_PHONE_NUMBER=+1XXXXXXXXXX

# --- Approval timeout in seconds (default 5 minutes) ---
APPROVAL_TIMEOUT_SECONDS=300

# --- Pipedream Webhook URLs ---
# Create workflows in Pipedream and paste the trigger URLs here

# Salesmsg
PIPEDREAM_SMS_SEND_URL=https://your-pipedream-url/sms-send
PIPEDREAM_SMS_RECEIVE_URL=https://your-pipedream-url/sms-receive
PIPEDREAM_SMS_LOOKUP_CONTACT_URL=https://your-pipedream-url/sms-lookup
PIPEDREAM_SMS_CREATE_CONTACT_URL=https://your-pipedream-url/sms-create

# WooDelivery
PIPEDREAM_TASK_CREATE_URL=https://your-pipedream-url/task-create
PIPEDREAM_TASK_UPDATE_URL=https://your-pipedream-url/task-update
PIPEDREAM_TASK_LOOKUP_URL=https://your-pipedream-url/task-lookup
PIPEDREAM_TASK_STATUS_URL=https://your-pipedream-url/task-status

# --- Logging ---
WDLAF_LOG_DIR=logs
WDLAF_KB_DIR=knowledge_base
